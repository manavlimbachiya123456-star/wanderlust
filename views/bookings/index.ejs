<% layout("/layouts/boilerplate.ejs") %>
<h2 class="mt-3">My Bookings</h2>

<% if (bookings.length === 0) { %>
  <p>No bookings yet.</p>
<% } else { %>
  <% for (let b of bookings) { %>
    <div class="card mb-3 p-3">
      <h5><%= b.listing.title %></h5>
      <p>
        <%= b.checkIn.toDateString() %> → <%= b.checkOut.toDateString() %><br>
        Guests: <%= b.guests %><br>
        Total: &#8377;<%= b.totalPrice.toLocaleString("en-IN") %>
      </p>
      <form action="/bookings/<%= b._id %>?_method=DELETE" method="POST">
        <button class="btn btn-outline-danger btn-sm">Cancel Booking</button>
      </form>
    </div>
  <% } %>
<% } %>