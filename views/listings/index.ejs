<% layout("/layouts/boilerplate.ejs") %>
<%= success %>

<style>
  #filters {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid #eee;
    padding-bottom: 1rem;
  }
  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 1rem;
    opacity: 0.7;
    transition: opacity 0.2s ease;
  }
  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }
  .listing-card {
    border: none;
    border-radius: 14px;
    overflow: hidden;
    transition: transform 0.2s ease;
  }
  .listing-card:hover {
    transform: translateY(-4px);
  }
  .listing-card img {
    height: 18rem;
    object-fit: cover;
  }
  .card-text {
    font-weight: 500;
  }
</style>

<div id="filters">
  <div class="filter">
    <div><i class="fa-solid fa-fire"></i></div>
    <p class="small mb-0">Trending</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-bed"></i></div>
    <p class="small mb-0">Rooms</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-mountain"></i></div>
    <p class="small mb-0">Mountain city</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-dungeon"></i></div>
    <p class="small mb-0">Castle</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-person-swimming"></i></div>
    <p class="small mb-0">Amazing pools</p>
  </div>
  <div class="filter">
    <div><i class="fa-solid fa-city"></i></div>
    <p class="small mb-0">Iconic City</p>
  </div>
</div>

<% if (alllistings.length === 0) { %>
  <div class="text-center mt-5">
    <h4>No listings found<% if (typeof q !== 'undefined' && q) { %> for "<%= q %>"<% } %></h4>
  </div>
<% } else { %>
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mt-2">

  <% for (let listing of alllistings) { %>
    <div class="col">
      <div class="card listing-card shadow-sm">
        <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
          <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image">
          <div class="card-body">
            <p class="card-text mb-1"><%= listing.title %></p>
            <p class="text-muted mb-0">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %> <span class="small">/ night</span></p>
          </div>
        </a>
      </div>
    </div>
  <% } %>

</div>
<% } %>