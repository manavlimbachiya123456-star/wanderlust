<% layout("/layouts/boilerplate.ejs") %>

<div class="container mt-5">

  <h3 class="text-center mb-5 fw-semibold"><%= listing.title %></h3>

  <div class="row justify-content-center">
    <div class="col-lg-6">

      <div class="card shadow-lg border-0 p-3 listing-card"">

        <img src="<%= listing.image.url %>" class="card-img-top listing-img mb-4" alt="Listing image">

        <div class="card-body pt-0">

          <h4 class="card-title mb-3"><%= listing.title %></h4>

          <ul class="list-group list-group-flush mb-4">
            <li class="list-group-item py-3">
           <li class="list-group-item py-3">
              <strong>Owner:</strong> <%= listing.owner.username %>
            </li>
            
            <li class="list-group-item py-3">
          <strong>Description:</strong> 
          <span class="ms-3"><%= listing.description %></span>
          </li>

            <li class="list-group-item py-3">
              <strong>Price:</strong> ₹ <%= listing.price.toLocaleString("en-IN") %>
            </li>

            <li class="list-group-item py-3">
              <strong>Location:</strong> <%= listing.location %>
            </li>

            <li class="list-group-item py-3">
              <strong>Country:</strong> <%= listing.country %>
            </li>
          </ul>


          
          <% if(curruser && curruser._id.equals(listing.owner._id)) {%>
          <div class="d-flex gap-3">

            <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark px-4">
              Edit
            </a>

            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
              <button class="btn btn-danger px-4">Delete</button>
            </form>

          </div>
          <% } %>


        </div>

      </div>

    </div>
  </div>


  <div class="col-8 offset-3">
    <hr />

   <%  if(curruser) { %>
    <h4>Leave a Review</h4>

    <form class="mb-3 needs-validation" action="/listings/<%=listing._id%>/reviews" method="post" novalidate >
    

        <fieldset class="starability-slot">
  <legend>Rating:</legend>

  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked />

  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1">1 star</label>

  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2">2 stars</label>

  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3">3 stars</label>

  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4">4 stars</label>

  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5">5 stars</label>
</fieldset>

        <div  class="mb-3 mt-3">
            <label class="form-label" for="comment">Comments</label>
            <textarea
                name="review[comment]"
                id="comment"
                cols="30"
                rows="5"
                class="form-control"
                required
            ></textarea>
        </div>

        <button class="btn btn-outline-dark">Submit</button>
    </form>
       <hr/>
    <% }  %>
 
   <p class="fw-bold fs-5 mt-4">All Reviews</p>

<div class="row">
  <% for (let review of listing.reviews) { %>

    <div class="col-md-6 mb-3">
      <div class="card shadow-sm border border-dark h-100">

        <div class="card-body">

          <!-- User + Rating -->
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h6 class="mb-0 fw-semibold">
              @<%= review.author ? review.author.username : "Anonymous" %>
            </h6>

            <p class="starability-result mb-0" data-rating="<%= review.rating %>"></p>
          </div>

          <!-- Comment -->
          <p class="card-text text-muted mb-3">
            <%= review.comment %>
          </p>

          <!-- Delete button -->
          <% if(curruser && review.author && curruser._id.equals(review.author._id)) { %>
            <form method="post" action="/listings/<%=listing._id %>/reviews/<%= review._id%>?_method=DELETE">
              <button class="btn btn-sm btn-outline-danger">
                Delete
              </button>
            </form>
          <% } %>

        </div>

      </div>
    </div>

  <% } %>
</div>


