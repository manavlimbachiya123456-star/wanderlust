<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
     <h1>Login</h1>
    <div class="col-6 offset-2">

        <form action="/login" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
              

                

                <div class="mb-3">
               <label for="username" class="form-label">Username</label>

                <input 
                name="username" 
                id="username"
                type="text" 
                class="form-control" 
                required
                />

               
                </div>

         <div class="mb-3">
               <label for="password" class="form-label">password</label>

                <input 
                name="password" 
                id="password"
               
                type="password" 
                class="form-control" 
                required
                />

                </div>
                <button>Login</button>
             
        </form>

    </div>
</div>