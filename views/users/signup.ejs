<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
  <h1>SignUp</h1>
  <div class="col-6 offset-2">

    <!-- STEP 1: hide once OTP sent -->
    <% if (typeof otpSent === 'undefined' || !otpSent) { %>
    <div id="step1">
      <form action="/signup/send-otp" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input
            name="email"
            id="email"
            type="email"
            class="form-control"
            required
          />
        </div>
        <button type="submit">Send OTP</button>
      </form>
    </div>
    <% } %>

    <!-- STEP 2 -->
    <% if (typeof otpSent !== 'undefined' && otpSent) { %>
    <div id="step2" class="mt-4">
      <form action="/signup/verify-otp" method="POST" class="needs-validation" novalidate>
        <div class="mb-3">
          <label for="username" class="form-label">Username</label>
          <input name="username" id="username" type="text" class="form-control" required />
        </div>

        <div class="mb-3">
          <label for="email2" class="form-label">Email</label>
          <input name="email" id="email2" type="email" class="form-control" value="<%= email %>" readonly required />
        </div>

        <div class="mb-3">
          <label for="password" class="form-label">Password</label>
          <input name="password" id="password" type="password" class="form-control" required />
        </div>

        <div class="mb-3">
          <label for="otp" class="form-label">Enter OTP</label>
          <input name="otp" id="otp" type="text" class="form-control" maxlength="6" required />
        </div>

        <button type="submit">Verify & Sign Up</button>
      </form>
    </div>
    <% } %>

  </div>
</div>